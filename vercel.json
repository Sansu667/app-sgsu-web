{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{documentacion/**,servidor/utilidades/trabajadorContrasenas.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:ruta*",
      "destination": "/api?__ruta=:ruta*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
